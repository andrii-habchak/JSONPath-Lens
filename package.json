{
  "name": "jsonpath-lens",
  "description": "Beautify JSON API responses and query them with JSONPath + regex.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrii-habchak/JSONPath-Lens.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "NODE_OPTIONS=--max-old-space-size=8000 tsx scripts/bench.ts",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@preact/signals": "^2.11.3",
    "codemirror": "^6.0.2",
    "json-p3": "^3.0.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
